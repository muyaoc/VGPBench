docker.enabled = true
docker.fixOwnership = true
// Docker 容器资源限制，防止容器无限制占用系统资源
docker.runOptions = '-u $(id -u):$(id -g) --memory=20g --memory-swap=24g --cpus=2 --cpu-shares=1024'

validation.lenientMode = true

process {
    cpus = 2
    // 固定内存上限，避免重试时无限增长导致系统死机
    memory = 20.GB
    errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    maxRetries = 3

    container = "zhandongliulab/aim-lite:1.2"
    cache = "lenient"
}
